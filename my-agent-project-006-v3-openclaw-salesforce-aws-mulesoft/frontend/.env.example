# 006 V3 frontend env template — copy to frontend/.env (gitignored)
# Vite injects every VITE_* var into the SPA at build time.

# ===========================================================================
# TRANSPORT — how the SPA talks to AgentCore
# ===========================================================================
# Two options: 'http' (default for deployed envs) or 'ws'.
#   http  — POST /agent/invoke through the API Gateway Lambda shim. Picks up
#           new envelope fields (action_plan, specialist_trace, queue_updates,
#           canonical gate_trace). Recommended for v3.
#   ws    — direct wss:// to the AgentCore runtime. Requires the runtime to
#           be publicly reachable and the browser to hold the bearer token.
VITE_AGENT_TRANSPORT=http

# WebSocket endpoint for AgentCore runtime (only when VITE_AGENT_TRANSPORT=ws).
# Scheme is always wss://; just the hostname here.
# e.g. bedrock-agentcore.us-east-1.amazonaws.com/runtimes/arn:aws:...
VITE_AGENTCORE_URL=agentcore.example.com

# REST base for the BFF + agent-proxy Lambdas (API Gateway invoke URL with
# stage). The SPA appends /agent/invoke and /agent/approve to this.
# e.g. https://abc123.execute-api.us-east-1.amazonaws.com/v3
VITE_API_URL=https://api.example.com

# Langfuse UI base URL — used to deep-link from the TraversalMap panel
# and AuditStrip to a span/trace. Leave unset to hide the "Open in Langfuse"
# link.
VITE_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ===========================================================================
# V2 UIUX — opt-in via URL param, no build-time flag needed
# ===========================================================================
# The v1 UI is the default. To use the v2 UI (uploaded design — Workflow 360
# branding, always-visible 7-gate tracker, 3-orch traversal map, inline
# ActionCard, phone-bezel client channel), append:
#
#   ?v2=1&persona=research
#   ?v2=1&persona=advisor
#   ?v2=1&persona=client
#
# See RUNBOOK.md Section 3.5 for the v1/v2 routing rules.

# ===========================================================================
# V3 — Cognito OAuth 2.0 PKCE (roadmap item #3)
# ===========================================================================
# When these are populated AND VITE_AUTH_DEV_BOOTSTRAP is unset/0, the v3
# SPA uses Cognito hosted UI for authentication. The agent-proxy Lambda
# verifies the resulting JWT access token against Cognito's JWKS endpoint.
#
# To enable:
#   1. Create a Cognito User Pool via CDK or Console.
#   2. Add an App Client with Hosted UI enabled and callback URL set to
#      https://<your-cloudfront>/auth/callback.
#   3. Populate these four vars from the Cognito console.
#
# See docs/v3-cognito-setup.md for the full playbook.

# VITE_COGNITO_DOMAIN=https://fsi-workforce-360.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REDIRECT_URI=https://d2zs9nk4uc2dbx.cloudfront.net/auth/callback
# VITE_COGNITO_SCOPE=openid profile email
