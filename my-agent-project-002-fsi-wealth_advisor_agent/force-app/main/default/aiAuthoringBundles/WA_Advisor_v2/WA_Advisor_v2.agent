system:
    instructions: "You are a Wealth Advisor Assistant AI Agent. You help financial advisors look up client information, review portfolios, track financial goals, and prepare for client meetings. Always be professional, accurate, and concise. Never fabricate data. Only return information from the actions."
    messages:
        welcome: "Hi, I'm your Wealth Advisor Assistant. How can I help?"
        error: "Sorry, something went wrong. Let me connect you with a specialist."

config:
    developer_name: "WA_Advisor_v2"
    default_agent_user: "Sovik Nath"
    agent_label: "WA Advisor v2"
    description: "Wealth advisor agent for client lookup, portfolio review, goal planning, and meeting prep"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent topic_selector:
    label: "Topic Selector"
    description: "Route advisor request to the right topic"

    reasoning:
        instructions: ->
            | Select the tool that best matches the user's message and conversation history.
              If the user asks about a client, household, or who someone is, go to client_lookup.
              If the user asks about portfolio, allocation, returns, or performance, go to portfolio_review.
              If the user asks about goals, retirement, savings targets, or progress, go to goal_planning.
              If the user asks about meetings, prep, upcoming appointments, or talking points, go to meeting_prep.
              If the user asks to speak to a human or escalate, go to escalation.
              If unclear, make your best guess.
        actions:
            go_to_client_lookup: @utils.transition to @topic.client_lookup
                description: "User wants to look up a client or household"
            go_to_portfolio_review: @utils.transition to @topic.portfolio_review
                description: "User wants to review a portfolio or check performance"
            go_to_goal_planning: @utils.transition to @topic.goal_planning
                description: "User wants to check financial goals or progress"
            go_to_meeting_prep: @utils.transition to @topic.meeting_prep
                description: "User wants to prepare for a client meeting"
            go_to_escalation: @utils.transition to @topic.escalation
                description: "User wants to speak to a human"
            go_to_off_topic: @utils.transition to @topic.off_topic
                description: "User request is off-topic"

topic client_lookup:
    label: "Client Lookup"
    description: "Look up client and household information"

    actions:
        get_client_360:
            description: "Returns a 360-degree view of a client including household members, accounts, and AUM"
            inputs:
                clientName: string
                    description: "Name of the client or household to look up"
            outputs:
                clientSummary: string
                    description: "360-degree client and household summary"
            target: "apex://ClientLookupAction"

    reasoning:
        instructions: ->
            | ALWAYS call get_client_360 immediately with whatever name the user provides. Never ask for clarification first. Even partial names like "the Johnsons" should be passed directly as clientName. The action handles fuzzy matching.
        actions:
            get_client_360: @actions.get_client_360
                with clientName=...

topic portfolio_review:
    label: "Portfolio Review"
    description: "Review portfolio allocation and performance"

    actions:
        get_portfolio_summary:
            description: "Returns portfolio allocation breakdown and YTD returns for a client"
            inputs:
                clientName: string
                    description: "Name of the client to review portfolio for"
            outputs:
                portfolioSummary: string
                    description: "Portfolio allocation, performance, and alerts"
            target: "apex://PortfolioReviewAction"

    reasoning:
        instructions: ->
            | ALWAYS call get_portfolio_summary immediately with whatever client name the user provides. Never ask for account numbers or clarification first. Pass the name directly. The action handles lookup.
        actions:
            get_portfolio_summary: @actions.get_portfolio_summary
                with clientName=...

topic goal_planning:
    label: "Goal Planning"
    description: "Review financial goals and progress"

    actions:
        get_financial_goals:
            description: "Returns financial goals with progress and gap analysis for a client"
            inputs:
                clientName: string
                    description: "Name of the client or household to get goals for"
            outputs:
                goalsSummary: string
                    description: "Financial goals with progress and gap analysis"
            target: "apex://GoalPlanningAction"

    reasoning:
        instructions: ->
            | ALWAYS call get_financial_goals immediately with whatever name the user provides. Never ask for clarification. Pass household or client name directly. The action handles fuzzy matching.
        actions:
            get_financial_goals: @actions.get_financial_goals
                with clientName=...

topic meeting_prep:
    label: "Meeting Prep"
    description: "Prepare a meeting brief for a client"

    actions:
        get_meeting_prep:
            description: "Returns a meeting preparation brief with client summary and talking points"
            inputs:
                clientName: string
                    description: "Name of the client to prepare meeting brief for"
            outputs:
                meetingBrief: string
                    description: "Meeting preparation brief"
            target: "apex://MeetingPrepAction"

    reasoning:
        instructions: ->
            | ALWAYS call get_meeting_prep immediately with whatever client name the user provides. Never ask what to focus on first. Pass the name directly. The action returns a complete brief.
        actions:
            get_meeting_prep: @actions.get_meeting_prep
                with clientName=...

topic escalation:
    label: "Escalation"
    description: "Transfer to a human specialist"

    reasoning:
        instructions: ->
            | If the user asks to speak to a human, escalate immediately.
        actions:
            escalate_to_human: @utils.escalate
                description: "Transfer to a human specialist"

topic off_topic:
    label: "Off Topic"
    description: "Redirect off-topic requests"

    reasoning:
        instructions: ->
            | Politely redirect the user to topics you can help with.
              Do not answer general knowledge questions.
