# ──────────────────────────────────────────────────────────────────────────
# V3 Agent Fabric frontend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────

# ── Salesforce OAuth (PKCE) ──
VITE_SF_LOGIN_URL=https://orgfarm-035b70d101-dev-ed.develop.my.salesforce.com
VITE_SF_CLIENT_ID=YOUR_CONNECTED_APP_CLIENT_ID
VITE_SF_REDIRECT_URI=http://localhost:5173/callback
VITE_SF_AGENT_ID=0XxgK000001JItVSAW

# ── V2 path: direct AWS API Gateway (kept as fallback for V2/V3 A/B testing) ──
VITE_API_GATEWAY_URL=https://og256a1neb.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_API_KEY=YOUR_AWS_API_KEY

# ── V3 path: Flex Gateway (Agent Fabric) ──
# When set, agentApi routes through the Flex Gateway ALB instead of direct API Gateway.
# Leave blank to keep V2 behaviour (useful for rollback + EVAL subagent comparison).
# Populated by the GATEWAY subagent into agent-fabric/.gateway-url.txt at deploy time.
VITE_FLEX_GATEWAY_URL=

# ── V3: Anypoint Agent Visualizer ──
# Base URL for linking to the Anypoint visualizer dashboard.
VITE_ANYPOINT_VISUALIZER_URL=https://anypoint.mulesoft.com/agent-fabric/visualizer
# Visualizer traces API (falls back to Langfuse if unreachable).
VITE_ANYPOINT_VISUALIZER_API=
# Anypoint org ID — required to scope visualizer embeds to the correct tenant.
VITE_ANYPOINT_ORG_ID=

# ── Identity headers emitted on every gateway call ──
# Agent ID rate-limit policy buckets requests by. Must match an entry in
# agent-fabric/agent-network.yaml.
VITE_AGENT_ID=ir-research-orchestrator

# ── Langfuse (observability + visualizer fallback) ──
VITE_LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
VITE_LANGFUSE_HOST=https://us.cloud.langfuse.com
