#%RAML 1.0
title: Submit Order Process API (v3)
version: v3
baseUri: /api
mediaType: application/json
description: |
  Project 006 v3 - MuleSoft Process API for submit_order + cancel/modify actions.
  Live backend: Alpaca paper trading. Mock branch available via mock_mode=true.
  All calls originate from the mulesoft-actions Lambda (MCP server).
  HITL approval is verified upstream; this API enforces shape + presence of
  plan_hash + approval_token_hash. Raw approval_token NEVER crosses this boundary.

types:
  SubmitOrderRequest:
    type: object
    additionalProperties: false
    properties:
      ticker:
        type: string
        pattern: "^[A-Z]{1,5}$"
        example: NVDA
      side:
        type: string
        enum: [buy, sell]
      quantity:
        type: number
        minimum: 0.000001
      order_type:
        type: string
        enum: [market, limit]
        required: false
        default: market
      limit_price:
        type: number
        required: false
      account_id:
        type: string
      plan_hash:
        type: string
        description: SHA-256 hex digest of canonical ActionPlan.
        pattern: "^[a-f0-9]{64}$"
      approval_token_hash:
        type: string
        description: SHA-256 hex digest of raw HMAC approval token.
        pattern: "^[a-f0-9]{64}$"

  CancelOrderRequest:
    type: object
    additionalProperties: false
    properties:
      order_id: string
      plan_hash:
        type: string
        pattern: "^[a-f0-9]{64}$"
      approval_token_hash:
        type: string
        pattern: "^[a-f0-9]{64}$"

  ModifyOrderRequest:
    type: object
    additionalProperties: false
    properties:
      order_id: string
      limit_price:
        type: number
        minimum: 0.01
      plan_hash:
        type: string
        pattern: "^[a-f0-9]{64}$"
      approval_token_hash:
        type: string
        pattern: "^[a-f0-9]{64}$"

  SubmitOrderResponse:
    type: object
    properties:
      order_id:
        type: string
      status:
        type: string
        enum: [accepted, new, filled, partially_filled, rejected, canceled]
      ticker: string
      side:
        type: string
        enum: [buy, sell]
      quantity: number
      submitted_at: integer
      mulesoft_reference: string

  ErrorResponse:
    type: object
    properties:
      error: string
      message: string
      missing_fields?:
        type: array
        items: string

/orders:
  post:
    body:
      application/json:
        type: SubmitOrderRequest
    responses:
      200:
        body:
          application/json:
            type: SubmitOrderResponse
      400:
        body:
          application/json:
            type: ErrorResponse
      403:
        body:
          application/json:
            type: ErrorResponse

  /{orderId}:
    /cancel:
      post:
        body:
          application/json:
            type: CancelOrderRequest
        responses:
          200:
            body:
              application/json:
                type: SubmitOrderResponse
          400:
            body:
              application/json:
                type: ErrorResponse
          403:
            body:
              application/json:
                type: ErrorResponse
    /modify:
      post:
        body:
          application/json:
            type: ModifyOrderRequest
        responses:
          200:
            body:
              application/json:
                type: SubmitOrderResponse
          400:
            body:
              application/json:
                type: ErrorResponse
          403:
            body:
              application/json:
                type: ErrorResponse

/health:
  get:
    responses:
      200:
        body:
          application/json:
            example: |
              {"status": "ok", "mode": "alpaca-paper", "api": "submit-order-process-api", "version": "v3"}
