        <displayFormat>CI-{00000000}</displayFormat>
        <label>Inquiry Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Client Inquiries</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
