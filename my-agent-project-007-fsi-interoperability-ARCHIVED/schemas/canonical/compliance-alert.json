{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://007.fsi/schemas/canonical/compliance-alert/v0.1.0",
  "title": "ComplianceAlert",
  "description": "Proactive compliance alert generated by OPA rules (M2/M4). NOT LLM-generated. Routed to compliance officer or principal. Covers BSA/AML, concentration, restricted list, MNPI breach, suitability drift.",
  "type": "object",
  "required": [
    "alert_id",
    "alert_type",
    "severity",
    "status",
    "triggered_by_rule",
    "wsp_section",
    "created_at"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary key for this compliance alert"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "restricted_list_violation",
        "concentration_breach",
        "suitability_drift",
        "mnpi_leakage_detected",
        "chinese_wall_breach",
        "bsa_aml_ctr",
        "bsa_aml_sar",
        "sanctions_match",
        "erisa_prohibited_transaction",
        "trading_window_violation",
        "rmd_missed",
        "wash_sale_detected",
        "principal_review_overdue",
        "cross_border_violation",
        "pod_isolation_breach"
      ],
      "description": "Classification of the compliance alert"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "description": "Alert severity. Critical = immediate action required. BSA/AML CTR/SAR are always critical."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "resolved",
        "escalated",
        "false_positive"
      ],
      "description": "Current alert lifecycle status"
    },
    "title": {
      "type": "string",
      "description": "Human-readable alert title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what triggered the alert"
    },
    "triggered_by_rule": {
      "type": "string",
      "description": "OPA rule path: e.g., bsa-aml/ctr_threshold.rego:check_ctr"
    },
    "policy_bundle_version": {
      "type": "string",
      "description": "OPA bundle version for reproducibility"
    },
    "wsp_section": {
      "type": "string",
      "description": "Written Supervisory Procedures section reference (REQUIRED per steering rule 19)"
    },
    "client_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Canonical Client ID if client-specific"
    },
    "account_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Canonical Account ID if account-specific"
    },
    "security_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Security identifier if security-specific"
    },
    "advisor_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Advisor whose action triggered the alert"
    },
    "firm_id": {
      "type": "string",
      "description": "Firm context for multi-tenant routing"
    },
    "archetype": {
      "type": [
        "string",
        "null"
      ],
      "description": "Firm archetype (tier3_bd, tier4_ria, etc.)"
    },
    "jurisdiction": {
      "type": [
        "string",
        "null"
      ],
      "description": "Regulatory jurisdiction (US, UK, EU, SG, HK)"
    },
    "assigned_to": {
      "type": [
        "string",
        "null"
      ],
      "description": "Compliance officer or principal assigned to review"
    },
    "escalation_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "escalated_to": {
            "type": "string"
          },
          "escalated_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "description": "Escalation history if alert was escalated"
    },
    "resolution": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "resolved_by": {
          "type": "string",
          "description": "Who resolved the alert"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the alert was resolved"
        },
        "resolution_type": {
          "type": "string",
          "enum": [
            "action_taken",
            "false_positive",
            "risk_accepted",
            "referred_to_regulator"
          ],
          "description": "Resolution type: action_taken, false_positive, risk_accepted, referred_to_regulator"
        },
        "resolution_notes": {
          "type": "string",
          "description": "Notes on the resolution"
        }
      },
      "description": "Resolution details if resolved"
    },
    "sla_deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Deadline for acknowledgment/resolution. BSA/AML SAR = 30 days."
    },
    "related_alerts": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Related alert IDs for pattern detection"
    },
    "evidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "Supporting evidence for the alert (hashed, not raw data)",
      "properties": {
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of input data"
        },
        "threshold_value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Threshold that was breached"
        },
        "actual_value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Actual value that triggered the alert"
        },
        "details": {
          "type": [
            "string",
            "null"
          ],
          "description": "Additional evidence details"
        }
      }
    },
    "trace_id": {
      "type": "string",
      "description": "Links to M10 audit trail"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Alert creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Alert last update timestamp"
    }
  }
}
