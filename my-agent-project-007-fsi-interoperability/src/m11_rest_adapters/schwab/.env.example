SECRETS_BACKEND=REPLACE_ME
VAULT_ADDR=REPLACE_ME
VAULT_TOKEN=REPLACE_ME
AWS_REGION=REPLACE_ME
ADAPTER_PORT=8080
ADAPTER_HTTP_TIMEOUT_MS=60000
ADAPTER_UNDICI_CONNECTIONS=10
MTLS_CLIENT_CERT_PATH=/etc/m11/mtls/tls.crt
MTLS_CLIENT_KEY_PATH=/etc/m11/mtls/tls.key
MTLS_CA_CERT_PATH=/etc/m11/mtls/ca.crt
MTLS_TRUSTED_SUBJECT_CN=REPLACE_ME
# PENDING-VERIFICATION sandbox default 120 RPM, 20 burst (AC5.2)
SCHWAB_RATE_LIMIT_RPM=120
SCHWAB_RATE_LIMIT_BURST=20
SCHWAB_API_VERSION=v1
SCHWAB_API_BASE_URL=https://api.schwabapi.com
SCHWAB_OAUTH_URL=https://api.schwabapi.com/v1/oauth/token
SCHWAB_EGRESS_ALLOWLIST=api.schwabapi.com,api-sandbox.schwabapi.com
LOG_LEVEL=info
