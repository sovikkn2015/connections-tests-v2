# Salesforce FSC adapter — local-dev env. ALL values REPLACE_ME.
# In production these come from Vault / AWS Secrets Manager (AC4.1, AC4.10).

SECRETS_BACKEND=REPLACE_ME
VAULT_ADDR=REPLACE_ME
VAULT_TOKEN=REPLACE_ME
AWS_REGION=REPLACE_ME

ADAPTER_PORT=8080
ADAPTER_HTTP_TIMEOUT_MS=60000
ADAPTER_UNDICI_CONNECTIONS=10

MTLS_CLIENT_CERT_PATH=/etc/m11/mtls/tls.crt
MTLS_CLIENT_KEY_PATH=/etc/m11/mtls/tls.key
MTLS_CA_CERT_PATH=/etc/m11/mtls/ca.crt
MTLS_TRUSTED_SUBJECT_CN=REPLACE_ME

# Rate limit (AC5.2 — SFDC 100K/24h, RPM=4166, BURST=200)
SFDC_RATE_LIMIT_RPM=4166
SFDC_RATE_LIMIT_BURST=200
SFDC_DAILY_LIMIT=100000

LOG_LEVEL=info
SIDECAR_ENABLED=true
OTEL_EXPORTER_OTLP_ENABLED=false

SFDC_API_VERSION=v59.0

# Egress FQDN allow-list (comma-separated)
SFDC_EGRESS_ALLOWLIST=login.salesforce.com,test.salesforce.com,my.salesforce.com,salesforce.com
