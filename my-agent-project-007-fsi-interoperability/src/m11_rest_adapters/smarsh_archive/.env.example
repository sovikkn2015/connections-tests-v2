SECRETS_BACKEND=REPLACE_ME
VAULT_ADDR=REPLACE_ME
VAULT_TOKEN=REPLACE_ME
AWS_REGION=REPLACE_ME
ADAPTER_PORT=8080
ADAPTER_HTTP_TIMEOUT_MS=60000
ADAPTER_UNDICI_CONNECTIONS=10
ADAPTER_VERSION=0.1.0
MTLS_ENABLED=true
MTLS_CLIENT_CERT_PATH=/etc/m11/mtls/tls.crt
MTLS_CLIENT_KEY_PATH=/etc/m11/mtls/tls.key
MTLS_CA_CERT_PATH=/etc/m11/mtls/ca.crt
MTLS_TRUSTED_SUBJECT_CN=REPLACE_ME
# PENDING-VERIFICATION Smarsh partner-portal rate limits; conservative defaults.
SMARSH_RATE_LIMIT_RPM=300
SMARSH_RATE_LIMIT_BURST=50
SMARSH_API_VERSION=v1
SMARSH_API_BASE_URL=https://api.smarsh.com
SMARSH_OAUTH_URL=https://auth.smarsh.com/oauth/token
SMARSH_EGRESS_ALLOWLIST=api.smarsh.com,auth.smarsh.com
# Auth mode toggle (mirror Orion OAuth/Basic pattern, Decision #8).
# oauth2: Smarsh Professional Archive (3 legacy tools).
# hmac:   Smarsh Connected Archive HMAC-SHA256 body signing (Phase 3 BD).
SMARSH_AUTH_MODE=oauth2
# Vault paths — ZERO literal credentials (Steering Rule 20).
SMARSH_OAUTH_CREDENTIALS_VAULT_PATH=m11/smarsh/oauth_credentials
SMARSH_API_KEY_VAULT_PATH=m11/smarsh/api_key
SMARSH_HMAC_SECRET_VAULT_PATH=m11/smarsh/hmac_secret
# Clock-skew tolerance for HMAC replay defence (default 300 s per spec §7.2).
SMARSH_HMAC_CLOCK_SKEW_SEC=300
LOG_LEVEL=info
