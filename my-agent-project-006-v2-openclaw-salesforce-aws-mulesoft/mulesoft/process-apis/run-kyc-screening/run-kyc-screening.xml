<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
      Project 006 v2 - run-kyc-screening Process API (mock backend).
      Listener on /api/*. Real vendor (LexisNexis/Refinitiv) integration lands in a later phase.
      Mock rules: sanctions=CLEAR, pep=CLEAR always. adverse_media=REVIEW only at ENHANCED level.
    -->

    <http:listener-config name="run-kyc-screening-http-listener-config" doc:name="HTTP Listener Config">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- ================================================================ -->
    <!-- POST /api/kyc                                                    -->
    <!-- ================================================================ -->
    <flow name="run-kyc-screening-main-flow" doc:name="run-kyc-screening-main-flow">
        <http:listener config-ref="run-kyc-screening-http-listener-config"
                       path="/api/kyc"
                       allowedMethods="POST"
                       doc:name="POST /api/kyc">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <logger level="INFO"
                doc:name="Log inbound (redacted)"
                message='#["[run-kyc-screening] inbound client_name=" ++ (payload.client_name default "?") ++ " level=" ++ (payload.level default "?") ++ " token_hash_prefix=" ++ ((payload.approval_token_hash default "") [0 to 7])]'/>

        <!-- ============== Validation ============== -->
        <choice doc:name="Validate required fields">
            <!-- Missing approval_token_hash: 403 -->
            <when expression="#[isEmpty(payload.approval_token_hash default '')]">
                <set-variable variableName="httpStatus" value="403" doc:name="status=403"/>
                <ee:transform doc:name="Build 403 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "approval_required",
  message: "approval_token_hash is required - this endpoint mimics the HITL gate"
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Missing required fields or client_name too short: 400 -->
            <when expression='#[
                isEmpty(payload.client_name default "")
                or sizeOf(payload.client_name default "") < 2
                or isEmpty(payload.level default "")
            ]'>
                <set-variable variableName="httpStatus" value="400" doc:name="status=400"/>
                <ee:transform doc:name="Build 400 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "missing_fields",
  message: "One or more required fields are missing or invalid",
  missing_fields: [
    if (isEmpty(payload.client_name default "") or sizeOf(payload.client_name default "") < 2) "client_name" else null,
    if (isEmpty(payload.level default "")) "level" else null
  ] filter ($ != null)
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Happy path -->
            <otherwise>
                <ee:transform doc:name="Normalize request (vars.normalized)">
                    <ee:variables>
                        <ee:set-variable variableName="normalized"><![CDATA[%dw 2.0
output application/json
---
{
  client_name: payload.client_name,
  level: payload.level,
  checks: payload.checks default ["sanctions", "pep"],
  approval_token_hash: payload.approval_token_hash
}]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <ee:transform doc:name="Build response payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
import * from dw::Runtime
output application/json
var uuid = randomUUID() replace "-" with ""
var lvl = vars.normalized.level
var results = (vars.normalized.checks default []) reduce ((chk, acc={}) ->
  acc ++ {
    (chk): if (chk == "adverse_media" and lvl == "ENHANCED") "REVIEW" else "CLEAR"
  }
)
---
{
  screening_id: "MULE-KYC-" ++ (uuid[0 to 7]),
  status: "COMPLETED",
  client_name: vars.normalized.client_name,
  level: vars.normalized.level,
  results: results,
  screened_at: (now() as Number {unit: "seconds"}) as Number {format: "#"},
  mulesoft_reference: "MS-REF-" ++ (uuid[0 to 11])
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

                <logger level="INFO"
                        doc:name="Log completed"
                        message='#["[run-kyc-screening] COMPLETED screening_id=" ++ (payload.screening_id default "?") ++ " ref=" ++ (payload.mulesoft_reference default "?")]'/>
            </otherwise>
        </choice>
    </flow>

    <!-- ================================================================ -->
    <!-- GET /api/health                                                  -->
    <!-- ================================================================ -->
    <flow name="run-kyc-screening-health-flow" doc:name="run-kyc-screening-health-flow">
        <http:listener config-ref="run-kyc-screening-http-listener-config"
                       path="/api/health"
                       allowedMethods="GET"
                       doc:name="GET /api/health">
            <http:response statusCode="200">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
        </http:listener>

        <ee:transform doc:name="Health payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "ok",
  mode: "mock",
  api: "run-kyc-screening-process-api"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

</mule>
