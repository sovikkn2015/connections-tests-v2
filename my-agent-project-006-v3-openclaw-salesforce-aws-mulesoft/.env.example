# 006 V3 environment template — copy to .env and fill in real values
# .env is GITIGNORED. Never commit real credentials.

# ========================================
# AWS
# ========================================
AWS_REGION_BEDROCK=us-east-1
AWS_REGION_LAMBDA=us-east-2
AWS_ACCOUNT_ID=<YOUR_AWS_ACCOUNT_ID>

# ========================================
# Bedrock models
# ========================================
BEDROCK_SONNET_MODEL_ID=anthropic.claude-sonnet-4-6-20260215-v1:0
BEDROCK_HAIKU_MODEL_ID=anthropic.claude-haiku-4-5-20251022-v1:0
BEDROCK_TITAN_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ========================================
# Salesforce (per-user OAuth via SF Auth Proxy)
# ========================================
SF_INSTANCE_URL=<YOUR_SF_INSTANCE_URL>
SF_OAUTH_CLIENT_ID=<YOUR_CONNECTED_APP_CONSUMER_KEY>
SF_OAUTH_CLIENT_SECRET=<YOUR_CONNECTED_APP_CONSUMER_SECRET>
SF_USERNAME=<YOUR_SF_INTEGRATION_USER>

# ========================================
# MuleSoft / Anypoint
# ========================================
MULESOFT_ORG_ID=<YOUR_ANYPOINT_ORG_ID>
MULESOFT_CLIENT_ID=<YOUR_ANYPOINT_CONNECTED_APP_CLIENT_ID>
MULESOFT_CLIENT_SECRET=<YOUR_ANYPOINT_CONNECTED_APP_CLIENT_SECRET>
MULESOFT_BASE_URL=<YOUR_ANYPOINT_CLOUDHUB_BASE>
# Mule 4.9 secure-properties bootstrap key (16-char ASCII).
# Used as the `mule.secure.properties.key` system property on each CloudHub app.
# Leave blank to have seed-secrets.sh auto-generate a random one.
MULE_SECURE_PROPERTIES_KEY=
# Anypoint environment for CloudHub 2.0 deploys (Sandbox|Production).
ANYPOINT_ENVIRONMENT=Sandbox
# HMAC secret used by Alpaca order-status webhook to sign inbound events.
# Leave blank to have seed-secrets.sh auto-generate a 64-char hex key.
WEBHOOK_HMAC_SECRET=

# ========================================
# Vendors (market data, filings, news, trading, wires)
# ========================================
FINNHUB_API_KEY=<YOUR_FINNHUB_KEY>              # signup: https://finnhub.io/register (free, 60 req/min)
TAVILY_API_KEY=<YOUR_TAVILY_KEY>                # signup: https://tavily.com (free, 1000 searches/mo)
ALPHA_VANTAGE_API_KEY=<YOUR_ALPHA_VANTAGE_KEY>  # signup: https://www.alphavantage.co/support/#api-key (free, 25 req/day)
ALPACA_KEY_ID=<YOUR_ALPACA_PAPER_KEY_ID>        # signup: https://alpaca.markets (free paper trading)
ALPACA_SECRET=<YOUR_ALPACA_PAPER_SECRET>
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
DWOLLA_KEY=<YOUR_DWOLLA_SANDBOX_KEY>            # signup: https://accounts-sandbox.dwolla.com (free sandbox)
DWOLLA_SECRET=<YOUR_DWOLLA_SANDBOX_SECRET>

# ========================================
# Observability
# ========================================
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>   # signup: https://cloud.langfuse.com (free tier)
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_HOST=https://cloud.langfuse.com

# ========================================
# Enterprise IdP (Okta or Azure AD) — OPTIONAL for demo
# Leave as placeholders to use dev-bootstrap-token auth instead.
# ========================================
IDP_ISSUER=placeholder
IDP_CLIENT_ID=placeholder
IDP_CLIENT_SECRET=placeholder

# ========================================
# Internal signing keys (generate with: openssl rand -hex 32)
# ========================================
AGENTCORE_SESSION_SIGNING_KEY=<GENERATE_64_HEX_CHARS>
HITL_SIGNING_KEY=<GENERATE_64_HEX_CHARS>
MCP_API_KEY=<GENERATE_64_HEX_CHARS>

# ========================================
# Demo-mode toggles
# ========================================
MULESOFT_MODE=sandbox               # mock | sandbox | production
OFAC_SDN_SOURCE=file                # file | treasury-daily
CLIENT_CHANNEL=web-mockup           # web-mockup | whatsapp | wechat | sms
