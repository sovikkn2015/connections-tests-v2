#%RAML 1.0
title: Run KYC Screening Process API
version: v1
baseUri: /api
mediaType: application/json
description: |
  Project 006 v2 - MuleSoft Process API for run_kyc_screening action.
  Mock backend: returns canned screening_id + CLEAR results. Real vendor (LexisNexis Bridger,
  Refinitiv World-Check, etc.) integration is a later step.
  All calls originate from the mulesoft-actions Lambda (MCP server).
  HITL approval is verified upstream; this API only enforces shape + presence of approval_token_hash.

types:
  Check:
    type: string
    enum: [sanctions, pep, adverse_media]

  KycRequest:
    type: object
    additionalProperties: false
    properties:
      client_name:
        type: string
        minLength: 2
      level:
        type: string
        enum: [STANDARD, ENHANCED]
      checks:
        type: array
        items: Check
        required: false
        default: [sanctions, pep]
      approval_token_hash:
        type: string
        description: SHA-256 hex digest of the raw ApprovalToken.
        pattern: "^[a-f0-9]{64}$"

  KycResults:
    type: object
    properties:
      sanctions?:
        type: string
        enum: [CLEAR, REVIEW, MATCH]
      pep?:
        type: string
        enum: [CLEAR, REVIEW, MATCH]
      adverse_media?:
        type: string
        enum: [CLEAR, REVIEW, MATCH]

  KycResponse:
    type: object
    properties:
      screening_id:
        type: string
        example: MULE-KYC-a1b2c3d4
      status:
        type: string
        enum: [COMPLETED]
      client_name: string
      level:
        type: string
        enum: [STANDARD, ENHANCED]
      results: KycResults
      screened_at:
        type: integer
        description: Unix epoch seconds
      mulesoft_reference:
        type: string

  ErrorResponse:
    type: object
    properties:
      error: string
      message: string
      missing_fields?:
        type: array
        items: string

/kyc:
  post:
    description: Run a KYC/AML screening. Mock always returns CLEAR (plus REVIEW for adverse_media at ENHANCED level).
    body:
      application/json:
        type: KycRequest
    responses:
      200:
        description: Screening completed.
        body:
          application/json:
            type: KycResponse
      400:
        description: Missing required fields or invalid shape.
        body:
          application/json:
            type: ErrorResponse
      403:
        description: approval_token_hash missing.
        body:
          application/json:
            type: ErrorResponse

/health:
  get:
    description: Liveness probe.
    responses:
      200:
        body:
          application/json:
            example: |
              {"status": "ok", "mode": "mock", "api": "run-kyc-screening-process-api"}
