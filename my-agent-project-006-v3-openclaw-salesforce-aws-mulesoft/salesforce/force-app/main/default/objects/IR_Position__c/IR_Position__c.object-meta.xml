<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Client position in a security. One row per household x ticker. Feeds Narrative 3 (Risk Alert) compliance_sweep which iterates over households at or above concentration threshold.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>IR Position</label>
    <nameField>
        <displayFormat>POS-{00000000}</displayFormat>
        <label>Position Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>IR Positions</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
