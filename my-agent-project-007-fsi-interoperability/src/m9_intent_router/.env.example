# M9 Intent Router -- example environment (AC14.4, Recommended Fix 7).
# Zero credential-shaped names. Vault path template, NOT a literal secret.

AWS_REGION=us-east-1
M9_PROVIDER=bedrock
M9_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
M9_TIMEOUT_MS=1500
M9_FALLBACK_ENABLED=true
M9_CONFIDENCE_HIGH=0.95
M9_CONFIDENCE_MED=0.80
M9_TENANT_HMAC_KEY_VAULT_PATH=secret/data/m9/tenants/<tenant_id>/hmac_key
