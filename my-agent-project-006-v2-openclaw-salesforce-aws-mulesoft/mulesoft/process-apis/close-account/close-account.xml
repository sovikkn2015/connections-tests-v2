<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
      Project 006 v2 - close-account Process API (mock backend).
      Listener on /api/*. Real core-banking + custodian integration lands in a later phase.
      close_account ALWAYS requires dual approval per 006 v2 steering rule 5 - no threshold logic.
    -->

    <http:listener-config name="close-account-http-listener-config" doc:name="HTTP Listener Config">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- ================================================================ -->
    <!-- POST /api/accounts/close                                         -->
    <!-- ================================================================ -->
    <flow name="close-account-main-flow" doc:name="close-account-main-flow">
        <http:listener config-ref="close-account-http-listener-config"
                       path="/api/accounts/close"
                       allowedMethods="POST"
                       doc:name="POST /api/accounts/close">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <logger level="INFO"
                doc:name="Log inbound (redacted)"
                message='#["[close-account] inbound client=" ++ (payload.client_id default "?") ++ " account=" ++ (payload.account_id default "?") ++ " token_hash_prefix=" ++ ((payload.approval_token_hash default "") [0 to 7]) ++ " dual_hash_prefix=" ++ ((payload.dual_approval_token_hash default "") [0 to 7])]'/>

        <!-- ============== Validation ============== -->
        <choice doc:name="Validate required fields">
            <!-- Missing approval_token_hash OR dual_approval_token_hash: 403 (close ALWAYS needs both) -->
            <when expression="#[isEmpty(payload.approval_token_hash default '') or isEmpty(payload.dual_approval_token_hash default '')]">
                <set-variable variableName="httpStatus" value="403" doc:name="status=403"/>
                <ee:transform doc:name="Build 403 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "dual_approval_required",
  message: "close_account ALWAYS requires both approval_token_hash AND dual_approval_token_hash per 006 v2 steering rule 5"
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Missing required fields or reason too short: 400 -->
            <when expression='#[
                isEmpty(payload.client_id default "")
                or isEmpty(payload.account_id default "")
                or isEmpty(payload.reason default "")
                or sizeOf(payload.reason default "") < 10
            ]'>
                <set-variable variableName="httpStatus" value="400" doc:name="status=400"/>
                <ee:transform doc:name="Build 400 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "missing_fields",
  message: "One or more required fields are missing or invalid (reason must be >= 10 chars)",
  missing_fields: [
    if (isEmpty(payload.client_id default "")) "client_id" else null,
    if (isEmpty(payload.account_id default "")) "account_id" else null,
    if (isEmpty(payload.reason default "") or sizeOf(payload.reason default "") < 10) "reason" else null
  ] filter ($ != null)
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Happy path -->
            <otherwise>
                <ee:transform doc:name="Normalize request (vars.normalized)">
                    <ee:variables>
                        <ee:set-variable variableName="normalized"><![CDATA[%dw 2.0
output application/json
---
{
  client_id: payload.client_id,
  account_id: payload.account_id,
  reason: payload.reason,
  approval_token_hash: payload.approval_token_hash,
  dual_approval_token_hash: payload.dual_approval_token_hash
}]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <ee:transform doc:name="Build response payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
import * from dw::Runtime
output application/json
var uuid = randomUUID() replace "-" with ""
---
{
  account_id: vars.normalized.account_id,
  status: "CLOSED",
  closed_at: (now() as Number {unit: "seconds"}) as Number {format: "#"},
  mulesoft_reference: "MS-REF-" ++ (uuid[0 to 11])
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

                <logger level="INFO"
                        doc:name="Log closed"
                        message='#["[close-account] CLOSED account_id=" ++ (payload.account_id default "?") ++ " ref=" ++ (payload.mulesoft_reference default "?")]'/>
            </otherwise>
        </choice>
    </flow>

    <!-- ================================================================ -->
    <!-- GET /api/health                                                  -->
    <!-- ================================================================ -->
    <flow name="close-account-health-flow" doc:name="close-account-health-flow">
        <http:listener config-ref="close-account-http-listener-config"
                       path="/api/health"
                       allowedMethods="GET"
                       doc:name="GET /api/health">
            <http:response statusCode="200">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
        </http:listener>

        <ee:transform doc:name="Health payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "ok",
  mode: "mock",
  api: "close-account-process-api"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

</mule>
