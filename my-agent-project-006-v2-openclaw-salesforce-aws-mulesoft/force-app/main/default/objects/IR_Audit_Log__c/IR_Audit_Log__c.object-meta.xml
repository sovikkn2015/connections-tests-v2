<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>FINRA-compliant audit trail for all agent actions. Records are immutable after creation.</description>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <label>IR Audit Log</label>
    <nameField>
        <displayFormat>AUD-{000000}</displayFormat>
        <label>Audit Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>IR Audit Logs</pluralLabel>
    <sharingModel>Read</sharingModel>
</CustomObject>
