{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://007.fsi/schemas/canonical/transaction/v0.1.0",
  "title": "Transaction",
  "description": "Canonical transaction record. Trade history, dividends, fees, transfers. Maps from custodian transaction feeds (Schwab, Fidelity, Pershing) and Orion transaction API.",
  "type": "object",
  "required": [
    "transaction_id",
    "account_ref",
    "transaction_type",
    "trade_date",
    "amount",
    "source_system"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary key for canonical transaction"
    },
    "account_ref": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical Account ID"
    },
    "client_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Canonical Client ID"
    },
    "order_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "Canonical Order ID if trade originated from 007"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "sell_short",
        "buy_to_cover",
        "dividend",
        "interest",
        "fee",
        "management_fee",
        "transfer_in",
        "transfer_out",
        "distribution",
        "contribution",
        "wire_in",
        "wire_out",
        "journal",
        "reinvestment",
        "return_of_capital",
        "corporate_action",
        "margin_interest"
      ],
      "description": "Transaction classification. Vendor-specific types normalized by M7 translator."
    },
    "security_identifier": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null for cash transactions (fees, wires)",
      "properties": {
        "ticker": {
          "type": [
            "string",
            "null"
          ],
          "description": "Exchange ticker symbol"
        },
        "cusip": {
          "type": [
            "string",
            "null"
          ],
          "description": "CUSIP identifier (9-char alphanumeric)"
        },
        "isin": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISIN identifier (2-letter country + 10 alphanum)"
        },
        "figi": {
          "type": [
            "string",
            "null"
          ],
          "description": "FIGI identifier (12-char alphanumeric)"
        },
        "sedol": {
          "type": [
            "string",
            "null"
          ],
          "description": "SEDOL identifier (7-char alphanumeric)"
        }
      }
    },
    "security_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Security display name"
    },
    "quantity": {
      "type": [
        "number",
        "null"
      ],
      "description": "Number of shares/units. Null for cash transactions."
    },
    "price": {
      "type": [
        "number",
        "null"
      ],
      "description": "Price per unit at execution"
    },
    "amount": {
      "type": "number",
      "description": "Total transaction amount (quantity * price for trades, or flat amount for fees/transfers)"
    },
    "commission": {
      "type": [
        "number",
        "null"
      ],
      "description": "Commission charged"
    },
    "fees": {
      "type": [
        "number",
        "null"
      ],
      "description": "SEC fees, exchange fees, etc."
    },
    "net_amount": {
      "type": [
        "number",
        "null"
      ],
      "description": "Amount after commissions and fees"
    },
    "trade_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trade was executed"
    },
    "settlement_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "T+1 for equities (since May 2024)"
    },
    "settlement_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pending",
        "settled",
        "failed",
        null
      ],
      "description": "Settlement lifecycle (ARCH-05 settlement states)"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Custodian-provided transaction description"
    },
    "tax_lot_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tax lot ID if this transaction created/closed a lot"
    },
    "cost_basis_impact": {
      "type": [
        "object",
        "null"
      ],
      "description": "Tax impact of this transaction",
      "properties": {
        "realized_gain_loss": {
          "type": [
            "number",
            "null"
          ],
          "description": "Realized gain or loss from this transaction"
        },
        "holding_period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "short_term",
            "long_term",
            null
          ],
          "description": "short_term or long_term"
        },
        "wash_sale_disallowed": {
          "type": [
            "number",
            "null"
          ],
          "description": "Disallowed loss if wash sale applies"
        }
      }
    },
    "account_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "taxable",
        "traditional_ira",
        "roth_ira",
        "401k",
        "403b",
        "457",
        "sep_ira",
        "simple_ira",
        "trust_revocable",
        "trust_irrevocable",
        "custodial_utma",
        "custodial_ugma",
        "erisa_pension",
        "erisa_profit_sharing",
        "529",
        "hsa",
        null
      ],
      "description": "Account type for ERISA/tax rules. Unified canonical enum per BLOCKER-8 resolution."
    },
    "source_system": {
      "type": "string",
      "enum": [
        "schwab",
        "schwab_sftp",
        "fidelity",
        "fidelity_sftp",
        "pershing",
        "orion",
        "envestnet",
        "manual"
      ],
      "description": "Source system that provided this transaction"
    },
    "source_id": {
      "type": "string",
      "description": "Custodian transaction ID"
    },
    "source_transaction_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Custodian's native transaction type code (for reconciliation)"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Links to M10 audit trail"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Transaction record creation timestamp"
    }
  }
}
