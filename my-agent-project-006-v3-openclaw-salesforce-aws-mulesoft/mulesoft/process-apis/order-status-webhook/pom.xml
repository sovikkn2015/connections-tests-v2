<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project 006 v3 - order-status-webhook Process API
  Mule 4.9.x Maven, CloudHub 2.0.

  Public HTTPS endpoint receiving Alpaca order-lifecycle callbacks. Verifies
  HMAC-SHA256 signature then fans out to the mulesoft-actions MCP server's
  order_status_webhook tool, which updates Salesforce positions / orders.

  Zero credentials. webhook.hmac_secret + mcp.bearer_token injected via
  Secure Properties at deploy.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId MUST equal the Anypoint businessGroupId (org UUID) for
         exchange-pre-deploy to resolve the artifact during `mvn deploy`.
         Same convention v2 uses. -->
    <groupId>2dc8acc5-23cb-424f-95a5-13686d8b9b16</groupId>
    <artifactId>order-status-webhook-process-api</artifactId>
    <version>3.0.10</version>
    <packaging>mule-application</packaging>
    <name>order-status-webhook-process-api</name>
    <description>006 v3 inbound Alpaca order-status callback -> mulesoft-actions MCP fan-out</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <app.runtime>4.9.0</app.runtime>
        <mule.maven.plugin.version>4.4.0</mule.maven.plugin.version>
        <munit.version>3.1.0</munit.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <cloudhub.app.name>openclaw-v3-order-status-webhook</cloudhub.app.name>
        <cloudhub.region>us-east-2</cloudhub.region>
        <cloudhub.vcores>0.1</cloudhub.vcores>
        <cloudhub.replicas>1</cloudhub.replicas>
        <cloudhub.environment>Sandbox</cloudhub.environment>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>1.9.0</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>1.2.5</version>
            <classifier>mule-plugin</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                    <!-- Base cloudhub2Deployment so `mvn mule:deploy` (default-cli)
                         resolves the config. Profile block below is kept for
                         `mvn deploy -Pcloudhub-sandbox` phase-bound invocations. -->
                    <cloudhub2Deployment>
                        <uri>https://anypoint.mulesoft.com</uri>
                        <muleVersion>${app.runtime}</muleVersion>
                        <javaVersion>17</javaVersion>
                        <applicationName>${cloudhub.app.name}</applicationName>
                        <environment>${cloudhub.environment}</environment>
                        <target>Cloudhub-US-East-2</target>
                        <provider>MC</provider>
                        <businessGroupId>${env.ANYPOINT_ORG_ID}</businessGroupId>
                        <replicas>${cloudhub.replicas}</replicas>
                        <vCores>${cloudhub.vcores}</vCores>
                        <connectedAppClientId>${env.ANYPOINT_CONNECTED_APP_ID}</connectedAppClientId>
                        <connectedAppClientSecret>${env.ANYPOINT_CONNECTED_APP_SECRET}</connectedAppClientSecret>
                        <connectedAppGrantType>client_credentials</connectedAppGrantType>
                        <artifact>${project.build.directory}/${project.build.finalName}-mule-application.jar</artifact>
                        <deploymentSettings>
                            <generateDefaultPublicUrl>true</generateDefaultPublicUrl>
                        </deploymentSettings>
                    </cloudhub2Deployment>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <formats>
                            <format>console</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cloudhub-sandbox</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.mule.tools.maven</groupId>
                        <artifactId>mule-maven-plugin</artifactId>
                        <version>${mule.maven.plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <cloudhub2Deployment>
                                <uri>https://anypoint.mulesoft.com</uri>
                                <muleVersion>${app.runtime}</muleVersion>
                        <javaVersion>17</javaVersion>
                                <applicationName>${cloudhub.app.name}</applicationName>
                                <environment>${cloudhub.environment}</environment>
                                <target>Cloudhub-US-East-2</target>
                                <provider>MC</provider>
                                <businessGroupId>${env.ANYPOINT_ORG_ID}</businessGroupId>
                                <replicas>${cloudhub.replicas}</replicas>
                                <vCores>${cloudhub.vcores}</vCores>
                                <connectedAppClientId>${env.ANYPOINT_CONNECTED_APP_ID}</connectedAppClientId>
                                <connectedAppClientSecret>${env.ANYPOINT_CONNECTED_APP_SECRET}</connectedAppClientSecret>
                                <connectedAppGrantType>client_credentials</connectedAppGrantType>
                                <username>${env.ANYPOINT_USERNAME}</username>
                                <password>${env.ANYPOINT_PASSWORD}</password>
                                <deploymentSettings>
                                    <generateDefaultPublicUrl>true</generateDefaultPublicUrl>
                                </deploymentSettings>
                            </cloudhub2Deployment>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <distributionManagement>
        <repository>
            <id>anypoint-exchange-v3</id>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${env.ANYPOINT_ORG_ID}/maven</url>
            <layout>default</layout>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${env.ANYPOINT_ORG_ID}/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <url>https://repository.mulesoft.org/releases/</url>
        </repository>
        <repository>
            <id>mulesoft-public</id>
            <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <url>https://repository.mulesoft.org/releases/</url>
        </pluginRepository>
        <pluginRepository>
            <id>mulesoft-public</id>
            <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
