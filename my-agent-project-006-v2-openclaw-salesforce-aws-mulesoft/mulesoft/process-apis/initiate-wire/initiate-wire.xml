<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!--
      Project 006 v2 - initiate-wire Process API (mock backend).
      Listener on /api/*. Real SWIFT/Fedwire integration lands in a later phase.
      The approval_token_hash (+ dual_approval_token_hash when amount > 100000) is logged
      in truncated form (first 8 chars) for traceability; raw tokens never reach this flow.
      Dual-auth threshold per 006 v2 steering rule 5 ($100K wire).
    -->

    <http:listener-config name="initiate-wire-http-listener-config" doc:name="HTTP Listener Config">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- ================================================================ -->
    <!-- POST /api/wires                                                  -->
    <!-- ================================================================ -->
    <flow name="initiate-wire-main-flow" doc:name="initiate-wire-main-flow">
        <http:listener config-ref="initiate-wire-http-listener-config"
                       path="/api/wires"
                       allowedMethods="POST"
                       doc:name="POST /api/wires">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:error-response>
        </http:listener>

        <logger level="INFO"
                doc:name="Log inbound (redacted)"
                message='#["[initiate-wire] inbound client=" ++ (payload.client_id default "?") ++ " amount=" ++ (payload.amount default "?" as String) ++ " currency=" ++ (payload.currency default "?") ++ " token_hash_prefix=" ++ ((payload.approval_token_hash default "") [0 to 7]) ++ " dual_hash_prefix=" ++ ((payload.dual_approval_token_hash default "") [0 to 7])]'/>

        <!-- ============== Validation ============== -->
        <choice doc:name="Validate required fields">
            <!-- Missing approval_token_hash: 403, mimics HITL gate -->
            <when expression="#[isEmpty(payload.approval_token_hash default '')]">
                <set-variable variableName="httpStatus" value="403" doc:name="status=403"/>
                <ee:transform doc:name="Build 403 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "approval_required",
  message: "approval_token_hash is required - this endpoint mimics the HITL gate"
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Dual-auth threshold: amount > 100000 requires dual_approval_token_hash -->
            <when expression="#[(payload.amount default 0) > 100000 and isEmpty(payload.dual_approval_token_hash default '')]">
                <set-variable variableName="httpStatus" value="403" doc:name="status=403"/>
                <ee:transform doc:name="Build 403 dual-auth payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "dual_approval_required",
  message: "Wires over $100,000 require dual_approval_token_hash per 006 v2 steering rule 5"
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Missing any other required field: 400 -->
            <when expression='#[
                isEmpty(payload.client_id default "")
                or isEmpty(payload.from_account default "")
                or isEmpty(payload.to_account default "")
                or (payload.amount default 0) <= 0
                or isEmpty(payload.currency default "")
            ]'>
                <set-variable variableName="httpStatus" value="400" doc:name="status=400"/>
                <ee:transform doc:name="Build 400 error payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  error: "missing_fields",
  message: "One or more required fields are missing or invalid",
  missing_fields: [
    if (isEmpty(payload.client_id default "")) "client_id" else null,
    if (isEmpty(payload.from_account default "")) "from_account" else null,
    if (isEmpty(payload.to_account default "")) "to_account" else null,
    if ((payload.amount default 0) <= 0) "amount" else null,
    if (isEmpty(payload.currency default "")) "currency" else null
  ] filter ($ != null)
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <!-- Happy path: normalize, then build response -->
            <otherwise>
                <ee:transform doc:name="Normalize request (vars.normalized)">
                    <ee:variables>
                        <ee:set-variable variableName="normalized"><![CDATA[%dw 2.0
output application/json
---
{
  client_id: payload.client_id,
  from_account: payload.from_account,
  to_account: payload.to_account,
  amount: payload.amount,
  currency: payload.currency,
  priority: payload.priority default "STANDARD",
  approval_token_hash: payload.approval_token_hash,
  dual_approval_token_hash: payload.dual_approval_token_hash default null
}]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <ee:transform doc:name="Build response payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
import * from dw::Runtime
output application/json
var uuid = randomUUID() replace "-" with ""
---
{
  wire_id: "MULE-WIRE-" ++ (uuid[0 to 7]),
  status: "INITIATED",
  amount: vars.normalized.amount,
  currency: vars.normalized.currency,
  from_account: vars.normalized.from_account,
  to_account: vars.normalized.to_account,
  submitted_at: (now() as Number {unit: "seconds"}) as Number {format: "#"},
  mulesoft_reference: "MS-REF-" ++ (uuid[0 to 11])
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>

                <logger level="INFO"
                        doc:name="Log initiated"
                        message='#["[initiate-wire] INITIATED wire_id=" ++ (payload.wire_id default "?") ++ " ref=" ++ (payload.mulesoft_reference default "?")]'/>
            </otherwise>
        </choice>
    </flow>

    <!-- ================================================================ -->
    <!-- GET /api/health                                                  -->
    <!-- ================================================================ -->
    <flow name="initiate-wire-health-flow" doc:name="initiate-wire-health-flow">
        <http:listener config-ref="initiate-wire-http-listener-config"
                       path="/api/health"
                       allowedMethods="GET"
                       doc:name="GET /api/health">
            <http:response statusCode="200">
                <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
            </http:response>
        </http:listener>

        <ee:transform doc:name="Health payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  status: "ok",
  mode: "mock",
  api: "initiate-wire-process-api"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

</mule>
