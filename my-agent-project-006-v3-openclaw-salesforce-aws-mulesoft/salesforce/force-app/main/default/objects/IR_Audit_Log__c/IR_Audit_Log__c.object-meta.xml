<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Immutable V3 audit trail. Enhanced from V2 with Research_Brief_Id__c + Client_Contact_Id__c for cross-persona stitching. Read-only after insert (enforced by trigger).</description>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>IR Audit Log</label>
    <nameField>
        <displayFormat>AUD-{00000000}</displayFormat>
        <label>Audit Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>IR Audit Logs</pluralLabel>
    <sharingModel>Read</sharingModel>
</CustomObject>
