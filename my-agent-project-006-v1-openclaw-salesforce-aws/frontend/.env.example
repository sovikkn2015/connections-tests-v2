# Default: AgentCore WebSocket endpoint (production path)
VITE_OPENCLAW_GATEWAY_URL=wss://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/YOUR_RUNTIME_ARN/ws
VITE_AGENTCORE_AUTH_MODE=oauth

# Local dev fallback: connect directly to OpenClaw Gateway on laptop
# VITE_OPENCLAW_GATEWAY_URL=ws://localhost:18789
# VITE_AGENTCORE_AUTH_MODE=

# Auth: SF OAuth token is used for OpenClaw authentication (no static gateway token)

VITE_SF_LOGIN_URL=https://login.salesforce.com
VITE_SF_CLIENT_ID=YOUR_SF_CLIENT_ID
VITE_SF_REDIRECT_URI=http://localhost:5173/callback

# Token proxy: required for CloudFront deployments (Salesforce token endpoint has no CORS).
# For local dev, leave unset — Vite proxy or direct SF endpoint works on localhost.
# VITE_SF_TOKEN_PROXY_URL=https://YOUR_API_GATEWAY_ID.execute-api.us-east-1.amazonaws.com/prod/auth/token

VITE_LANGFUSE_HOST=https://us.cloud.langfuse.com
