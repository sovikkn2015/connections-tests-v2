{
  "name": "006 Credential Scan",
  "version": "1.0.0",
  "description": "Scans new and edited files in the 006 project for API keys, org URLs, passwords, tokens, and secrets before they are committed.",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "my-agent-project-006-v1-openclaw-salesforce-aws/**",
      "my-agent-project-006-v2-openclaw-salesforce-aws-mulesoft/**"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Scan this file for hardcoded credentials: API keys, OAuth tokens, org-specific URLs (*.salesforce.com, *.amazonaws.com with account IDs), passwords, secret keys, bearer tokens, Langfuse keys, Tavily keys, Alpha Vantage keys, Polygon keys, EODHD keys, or any string that looks like a secret. Files named .env.example should have PLACEHOLDER values only (YOUR_KEY_HERE, REPLACE_WITH_*, etc). If credentials found, replace with placeholders and warn. If clean, confirm."
  }
}