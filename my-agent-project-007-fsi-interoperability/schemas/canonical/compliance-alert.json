{
  "$defs": {
    "AlertEvidence": {
      "description": "Supporting evidence for a compliance alert.",
      "properties": {
        "input_hash": {
          "description": "SHA-256 hash of the input that triggered the alert.",
          "title": "Input Hash",
          "type": "string"
        },
        "threshold_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threshold that was breached.",
          "title": "Threshold Value"
        },
        "actual_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Actual value that triggered the alert.",
          "title": "Actual Value"
        },
        "details": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Additional evidence details.",
          "title": "Details"
        }
      },
      "required": [
        "input_hash"
      ],
      "title": "AlertEvidence",
      "type": "object"
    },
    "AlertResolution": {
      "description": "Resolution details for a compliance alert.",
      "properties": {
        "resolved_by": {
          "description": "Person who resolved the alert.",
          "title": "Resolved By",
          "type": "string"
        },
        "resolved_at": {
          "description": "When the alert was resolved.",
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        },
        "resolution_type": {
          "description": "Resolution type: action_taken, false_positive, risk_accepted, referred_to_regulator.",
          "title": "Resolution Type",
          "type": "string"
        },
        "resolution_notes": {
          "description": "Notes on the resolution.",
          "title": "Resolution Notes",
          "type": "string"
        }
      },
      "required": [
        "resolved_by",
        "resolved_at",
        "resolution_type",
        "resolution_notes"
      ],
      "title": "AlertResolution",
      "type": "object"
    },
    "AlertSeverity": {
      "description": "5 alert severity levels. Critical = immediate action required.",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "AlertSeverity",
      "type": "string"
    },
    "AlertStatus": {
      "description": "6 alert lifecycle statuses.",
      "enum": [
        "open",
        "acknowledged",
        "investigating",
        "resolved",
        "escalated",
        "false_positive"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "AlertType": {
      "description": "15 compliance alert types generated by M2/M4 OPA rules.",
      "enum": [
        "restricted_list_violation",
        "concentration_breach",
        "suitability_drift",
        "mnpi_leakage_detected",
        "chinese_wall_breach",
        "bsa_aml_ctr",
        "bsa_aml_sar",
        "sanctions_match",
        "erisa_prohibited_transaction",
        "trading_window_violation",
        "rmd_missed",
        "wash_sale_detected",
        "principal_review_overdue",
        "cross_border_violation",
        "pod_isolation_breach"
      ],
      "title": "AlertType",
      "type": "string"
    },
    "EscalationEntry": {
      "description": "Escalation history entry for compliance alerts.",
      "properties": {
        "escalated_to": {
          "description": "Person or role escalated to.",
          "title": "Escalated To",
          "type": "string"
        },
        "escalated_at": {
          "description": "When escalation occurred.",
          "format": "date-time",
          "title": "Escalated At",
          "type": "string"
        },
        "reason": {
          "description": "Reason for escalation.",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "escalated_to",
        "escalated_at",
        "reason"
      ],
      "title": "EscalationEntry",
      "type": "object"
    }
  },
  "description": "Proactive compliance alert generated by OPA rules. wsp_section is REQUIRED per steering rule 19.",
  "properties": {
    "alert_id": {
      "description": "Primary key for this compliance alert.",
      "format": "uuid",
      "title": "Alert Id",
      "type": "string"
    },
    "alert_type": {
      "$ref": "#/$defs/AlertType",
      "description": "Classification of the compliance alert."
    },
    "severity": {
      "$ref": "#/$defs/AlertSeverity",
      "description": "Alert severity. Critical = immediate action required."
    },
    "status": {
      "$ref": "#/$defs/AlertStatus",
      "description": "Current alert lifecycle status."
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable alert title.",
      "title": "Title"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Detailed description of what triggered the alert.",
      "title": "Description"
    },
    "triggered_by_rule": {
      "description": "OPA rule path that triggered this alert.",
      "title": "Triggered By Rule",
      "type": "string"
    },
    "policy_bundle_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "OPA bundle version for reproducibility.",
      "title": "Policy Bundle Version"
    },
    "wsp_section": {
      "description": "Written Supervisory Procedures section reference. REQUIRED per steering rule 19.",
      "title": "Wsp Section",
      "type": "string"
    },
    "client_ref": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical Client ID if client-specific.",
      "title": "Client Ref"
    },
    "account_ref": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical Account ID if account-specific.",
      "title": "Account Ref"
    },
    "security_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Security identifier if security-specific.",
      "title": "Security Ref"
    },
    "advisor_ref": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Advisor whose action triggered the alert.",
      "title": "Advisor Ref"
    },
    "firm_id": {
      "description": "Firm context for multi-tenant routing.",
      "title": "Firm Id",
      "type": "string"
    },
    "archetype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Firm archetype (tier3_bd, tier4_ria, etc.).",
      "title": "Archetype"
    },
    "jurisdiction": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Regulatory jurisdiction (US, UK, EU, SG, HK).",
      "title": "Jurisdiction"
    },
    "assigned_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Compliance officer or principal assigned to review.",
      "title": "Assigned To"
    },
    "escalation_chain": {
      "description": "Escalation history.",
      "items": {
        "$ref": "#/$defs/EscalationEntry"
      },
      "title": "Escalation Chain",
      "type": "array"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertResolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Resolution details if resolved."
    },
    "sla_deadline": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deadline for acknowledgment/resolution.",
      "title": "Sla Deadline"
    },
    "related_alerts": {
      "description": "Related alert IDs for pattern detection.",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Related Alerts",
      "type": "array"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Supporting evidence."
    },
    "trace_id": {
      "description": "Links to M10 audit trail.",
      "title": "Trace Id",
      "type": "string"
    },
    "created_at": {
      "description": "Alert creation timestamp.",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "description": "Alert last update timestamp.",
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "alert_id",
    "alert_type",
    "severity",
    "status",
    "triggered_by_rule",
    "wsp_section",
    "firm_id",
    "trace_id",
    "created_at",
    "updated_at"
  ],
  "title": "ComplianceAlert",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://007.fsi/schemas/canonical/compliance-alert/v0.1.0"
}