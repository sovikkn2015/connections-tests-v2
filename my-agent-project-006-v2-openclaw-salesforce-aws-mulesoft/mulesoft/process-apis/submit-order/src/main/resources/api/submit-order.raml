#%RAML 1.0
title: Submit Order Process API
version: v1
baseUri: /api
mediaType: application/json
description: |
  Project 006 v2 - MuleSoft Process API for submit_order action.
  Mock backend: returns canned order_id/status. Real OMS integration is a later step.
  All calls originate from the mulesoft-actions Lambda (MCP server).
  HITL approval is verified upstream; this API only enforces shape + presence of approval_token_hash.

types:
  SubmitOrderRequest:
    type: object
    additionalProperties: false
    properties:
      ticker:
        type: string
        pattern: "^[A-Z]{1,5}$"
        example: AAPL
      side:
        type: string
        enum: [BUY, SELL]
      quantity:
        type: integer
        minimum: 1
      order_type:
        type: string
        enum: [MARKET, LIMIT]
        required: false
        default: MARKET
      limit_price:
        type: number
        required: false
      client_id:
        type: string
      account_id:
        type: string
      approval_token_hash:
        type: string
        description: SHA-256 hex digest of the raw ApprovalToken. Raw token never crosses this boundary.
        pattern: "^[a-f0-9]{64}$"

  SubmitOrderResponse:
    type: object
    properties:
      order_id:
        type: string
        example: MULE-ORDER-a1b2c3d4
      status:
        type: string
        enum: [SUBMITTED, REJECTED]
      ticker: string
      side:
        type: string
        enum: [BUY, SELL]
      quantity: integer
      submitted_at:
        type: integer
        description: Unix epoch seconds
      mulesoft_reference:
        type: string

  ErrorResponse:
    type: object
    properties:
      error: string
      message: string
      missing_fields?:
        type: array
        items: string

/orders:
  post:
    description: Submit a single trade order. Mock implementation returns a canned response.
    body:
      application/json:
        type: SubmitOrderRequest
    responses:
      200:
        description: Order accepted and submitted to downstream OMS (mock).
        body:
          application/json:
            type: SubmitOrderResponse
      400:
        description: Missing required fields or invalid shape.
        body:
          application/json:
            type: ErrorResponse
      403:
        description: approval_token_hash missing - mimics real-world HITL gate.
        body:
          application/json:
            type: ErrorResponse

/health:
  get:
    description: Liveness probe.
    responses:
      200:
        body:
          application/json:
            example: |
              {"status": "ok", "mode": "mock", "api": "submit-order-process-api"}
